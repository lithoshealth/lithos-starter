# Lithos Starter — environment variable NAMES only. Never commit values.
# Copy to .env.local (gitignored) for local development; set them in your host's
# environment settings when you deploy.

# --- Required for /setup -------------------------------------------------------
# Your Lithos sandbox organization's machine-to-machine credentials. The secret
# is shown once when the organization is provisioned; if it's lost, ask for a
# rotation rather than a resend.
LITHOS_API_BASE_URL=https://api.sandbox.lithoshealth.com
LITHOS_TOKEN_URL=https://api.sandbox.lithoshealth.com/v1/oauth2/token
LITHOS_CLIENT_ID=
LITHOS_CLIENT_SECRET=

# --- From step 5 of /setup -----------------------------------------------------
# Returned exactly once when you register a webhook endpoint. Verifies the
# X-Lithos-Signature header (t=<ts>,v1=<hex>; v1 = HMAC-SHA256 over
# "<t>.<raw body>") on every delivery. Restart the app after setting it.
LITHOS_WEBHOOK_SECRET=

# --- Optional ------------------------------------------------------------------
# The app is sandbox-only: pointed at any other Lithos API it refuses to run,
# and the demo sign-in and ops pages switch off. Set to 1 only when you're taking
# it live on purpose — read "Taking it to production" in the README first.
LITHOS_ALLOW_NON_SANDBOX=

# The email step 1 signed up with, written there. "Email it" on /setup sends the
# app to it — after a demo, that's the prospect. Not a credential.
LITHOS_SIGNUP_EMAIL=

# The brand (name, tagline, colour, logo) isn't an env var: it's in
# starter.config.json, edited from the "Make it yours" panel on /setup.

# Patient notifications. When a webhook is the patient's to know (a message from
# the care team, a shipped order), the app tells them — content-free, with a
# link into the app. Without these, notifications go to the outbox on /events
# and nothing is sent. With both, they're emailed through Resend.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=
# The app's public address, for links in notifications. Defaults to the address
# the webhook arrived on.
APP_URL=

# The partner's own database — members, their history, and local copies of
# Lithos state. Leave it empty locally: `npm run dev` runs Postgres itself
# (embedded, data in .lithos-db/). Set it to a hosted Postgres when you deploy.
DATABASE_URL=

# Durable webhook event storage when deployed without DATABASE_URL (Upstash
# Redis). Locally the app uses memory; deployed, it refuses to.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
